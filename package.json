{
  "name": "dybur-monorepo",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "Fast, local, private voice dictation",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/asr-candidate-runner.test.js scripts/asr-eval.test.js scripts/asr-gate.test.js scripts/asr-manifest-check.test.js scripts/cli-candidates.test.js scripts/verify-macos-release.test.js scripts/verify-release.test.js",
    "lint": "eslint \"packages/**/*.ts\"",
    "format": "prettier --write \"packages/**/*.ts\"",
    "typecheck": "pnpm --filter @dybur/config build && pnpm --filter @dybur/core build && pnpm -r typecheck",
    "eval:asr": "node scripts/asr-eval.js",
    "eval:asr:gate": "node scripts/asr-gate.js",
    "eval:asr:manifest": "node scripts/asr-manifest-check.js",
    "eval:asr:candidates": "node scripts/asr-candidate-runner.js",
    "release:verify": "node scripts/verify-release.js",
    "release:verify:macos": "node scripts/verify-macos-release.js",
    "release:verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-release.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
