{
  "name": "dybur-monorepo",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "description": "Fast, local, private voice dictation",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint \"packages/**/*.ts\"",
    "format": "prettier --write \"packages/**/*.ts\"",
    "typecheck": "pnpm --filter @dybur/config build && pnpm --filter @dybur/core build && pnpm -r typecheck",
    "eval:asr": "node scripts/asr-eval.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
